  visible         Boolean           @default(true)
  status          WebsitePageStatus @default(DRAFT)
  deleteOnPublish Boolean           @default(false)
  publishedData   Json?
  publishedAt     DateTime?
  width           Int?
  height          Int?
  fileSize        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([category])
  @@index([position])
  @@index([visible])
  @@index([status])
}

model WebsiteNavItem {
  id            String            @id @default(cuid())
  label         String
  url           String
  position      Int               @default(0)
  visible       Boolean           @default(true)
  openNewTab    Boolean           @default(false)
  parentId      String?
  status        WebsitePageStatus @default(DRAFT)
  publishedData Json?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([position])
  @@index([parentId])
  @@index([status])
}

model WebsiteSettings {
  id                String    @id @default(cuid())
  businessName      String?
  shortDescription  String?   @db.Text
  phone             String?
  phone2            String?
  whatsapp          String?
  email             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pinCode           String?
  googleMapsUrl     String?   @db.Text
  googleBusinessUrl String?
  serviceArea       String?
  businessHours     Json?
  websiteUrl        String?
  primaryLogoUrl    String?
  lightLogoUrl      String?
  darkLogoUrl       String?
  mobileLogoUrl     String?
  faviconUrl        String?
  defaultOgImage    String?
  footerContent     String?   @db.Text
  copyrightText     String?
  founderName       String?
  founderTitle      String?
  founderBio        String?   @db.Text
  founderPhoto      String?
  mission           String?   @db.Text
  vision            String?   @db.Text
  publishedData     Json?
  publishedAt       DateTime?
  updatedAt         DateTime  @updatedAt
}

model WebsiteSeo {
  id                 String    @id @default(cuid())
  globalTitle        String?
  globalDescription  String?   @db.Text
  defaultOgImage     String?
  twitterTitle       String?
  twitterDescription String?   @db.Text
  twitterImage       String?
  canonicalUrl       String?
  robotsSettings     String?
  structuredData     Json?
  publishedData      Json?
  publishedAt        DateTime?
  updatedAt          DateTime  @updatedAt
}

// Last published versions of website items, so an overwrite or unpublish can be undone (kept: newest 10 per item).
model WebsiteRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  label      String
  snapshot   Json
  createdAt  DateTime @default(now())
  createdBy  String?

  @@index([entityType, entityId, createdAt])
}

// ─── Invoicing ───────────────────────────────────────────────────────────────
// Added for the invoice feature (owner's answers, 2026-09-21). Purely additive: no existing model,
// column or index is touched, and a quotation is linked only by an optional foreign key on Invoice.

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  // Bare running number, allocated only on issue, so an abandoned draft leaves no gap in the series.
  number        Int?          @unique
  date          String
  dueDate       String?
  status        InvoiceStatus @default(DRAFT)
  subject       String?
  purchaseOrder String?
  reverseCharge Boolean       @default(false)

  clientId            String?
  client              Client? @relation(fields: [clientId], references: [id])
  clientCompanyName   String
  clientContactPerson String?
  clientAddressLine1  String?
  clientAddressLine2  String?
  clientCity          String?
  clientState         String?
  clientPinCode       String?
  clientPhone         String?
  clientEmail         String?
  clientGstin         String?

  // Printed only when it differs from the billing address.
  shipToSameAsBilling Boolean @default(true)
  shipToName          String?
  shipToAddressLine1  String?
  shipToAddressLine2  String?
  shipToCity          String?
  shipToState         String?
  shipToPinCode       String?
  shipToPhone         String?

  discountType  String? // PERCENT | FLAT | null
  discountValue Decimal @default(0) @db.Decimal(12, 2)
  gstEnabled    Boolean @default(true)
  gstMode       String  @default("CGST_SGST") // CGST_SGST | IGST
  gstRate       Decimal @default(18) @db.Decimal(5, 2)

  // The quotation it was converted from, if any. A copy, not a live link: editing either document
  // never changes the other, and the reference is kept only so each can show the other.
  quotationId        String?
  quotation          Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  quotationReference String?

  templateId       String?
  template         InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateSnapshot Json?
  // The switch settings this invoice was drawn with, frozen on issue so a later settings change
  // cannot silently alter an invoice already in a client's hands.
  settingsSnapshot Json?
  // Only the switches turned on or off for THIS invoice, not a whole settings object: a segment the
  // owner never touched here keeps following the global setting, including when that setting changes.
  settingsOverride Json?

  items       InvoiceItem[]
  payments    InvoicePayment[]
  creditNotes CreditNote[]
  edits       InvoiceEdit[]

  issuedAt        DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([clientId])
  @@index([quotationId])
  @@index([dueDate])
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int      @default(0)
  description     String
  unit            String
  quantity        Decimal  @db.Decimal(10, 2)
  rate            Decimal  @db.Decimal(12, 2)
  // Optional and independent of GST: the owner may charge GST with no HSN, or print HSN without GST.
  hsn             String?
  discountPercent Decimal? @db.Decimal(5, 2)
  gstRate         Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
}

model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      String
  amount    Decimal  @db.Decimal(12, 2)
  method    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model CreditNote {
  id        String    @id @default(cuid())
  number    Int?      @unique
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      String
  amount    Decimal   @db.Decimal(12, 2)
  reason    String
  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([invoiceId])
}

// Editing an issued invoice stays allowed (the owner's choice), so every change is recorded here.
model InvoiceEdit {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  editedBy  String?
  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
}

// Wording for an invoice. The page design lives in code and is picked by `layout`.
model InvoiceTemplate {
  id         String    @id @default(cuid())
  name       String
  layout     String    @default("clean")
  content    Json
  isDefault  Boolean   @default(false)
  // A proforma prints a different title and takes no number from the GST series.
  isProforma Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  invoices   Invoice[]

  @@index([isDefault])
}

// One row. Holds the switch settings, the business values the owner fills in, and the uploaded
// signature, stamp and UPI QR images.
model InvoiceSetting {
  id           String   @id @default("singleton")
  settings     Json
  bankDetails  Json?
  signatureUrl String?
  stampUrl     String?
  upiQrUrl     String?
  updatedAt    DateTime @updatedAt
}

// The HSN or SAC code the owner has chosen for an item name, so it is typed once and then remembered.
model InvoiceItemCode {
  id          String   @id @default(cuid())
  description String   @unique
  hsn         String
  unit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * A unit the owner typed that was not built in. Offered on every later quotation and invoice.
 */
model CustomUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model InvoiceNumberCounter {
  id         String @id @default("invoice")
  lastNumber Int    @default(764)
}

// ─── Admin app: enquiries, notifications, Face ID ────────────────────────────

/** A proposal request from the website's quote form. Stored before it is emailed, so none is lost. */
model Enquiry {
  id           String    @id @default(cuid())
  name         String
  organisation String?
  phone        String
  email        String?
  service      String
  location     String
  details      String?   @db.Text
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

/** One device that asked for enquiry notifications (the browser's Web Push subscription). */
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

/** The site's Web Push identity. One row, generated the first time a notification is needed. */
model VapidKey {
  id         String   @id @default("default")
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

/** A Face ID / Touch ID credential (WebAuthn passkey) that can sign its owner in. */
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/** A WebAuthn challenge awaiting its answer. Deleted when used, so a response can never be replayed. */
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Workers and expenses ────────────────────────────────────────────────────

/** A crew member. "Removing" one archives him (active = false): his work and payment history is kept. */
model Worker {
  id             String        @id @default(cuid())
  name           String
  phone          String?
  role           String?
  notes          String?
  /** What was pending before the app: positive = the business owed him, negative = he had an advance. */
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  active         Boolean       @default(true)
  entries        WorkerEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([active])
}

/** One line of a worker's ledger: work done (earned) or money given (paid). See lib/worker-ledger.ts. */
model WorkerEntry {
  id          String    @id @default(cuid())
  workerId    String
  worker      Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  kind        String // "WORK" | "PAYMENT"
  date        String // YYYY-MM-DD
  description String
  site        String?
  quantity    Decimal?  @db.Decimal(10, 2)
  unit        String?
  rate        Decimal?  @db.Decimal(12, 2)
  /** Work: quantity × rate, stored as it was calculated. Payment: the amount given. */
  amount      Decimal   @db.Decimal(12, 2)
  method      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([workerId, date])
}

/** A business cost that is not money handed to a worker: rig diesel, repairs, drill bits, site food. */
model Expense {
  id          String    @id @default(cuid())
  date        String // YYYY-MM-DD
  amount      Decimal   @db.Decimal(12, 2)
  category    String
  description String?
  forWhat     String?
  method      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([date])
}
