# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (pooled via Prisma Accelerate or PgBouncer)
DATABASE_URL="postgresql://user:password@localhost:5432/stbs?schema=public"
# Direct PostgreSQL URL (for migrations and heavy queries, bypasses pooling)
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/stbs?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# NextAuth secret for session encryption (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"
# Admin seed credentials (used by `npx prisma db seed` to create the first admin)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me-on-first-login"
ADMIN_SEED_NAME="STBS Administrator"

# ─── Application ──────────────────────────────────────────────────────────────
# Public site URL (used for PDF generation, email links, etc.)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
# S3 endpoint (use for MinIO, Cloudflare R2, etc.)
STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# S3 bucket name
STORAGE_BUCKET="stbs-documents"
# S3 region
STORAGE_REGION="ap-south-1"
# S3 access key ID
STORAGE_ACCESS_KEY_ID="your-access-key"
# S3 secret access key
STORAGE_SECRET_ACCESS_KEY="your-secret-key"

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# SMTP server hostname
SMTP_HOST="smtp.gmail.com"
# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT="587"
# SMTP username / email address
SMTP_USER="noreply@example.com"
# SMTP password or app-specific password
SMTP_PASSWORD="your-smtp-password"
# Default "from" address for outgoing emails
SMTP_FROM="STBS <noreply@example.com>"

# ─── Redis (Job Queue & Caching) ─────────────────────────────────────────────
# Redis connection URL
REDIS_URL="redis://localhost:6379"

# ─── Jobs ─────────────────────────────────────────────────────────────────────
# Maximum concurrent background jobs per worker
JOB_MAX_CONCURRENT="5"
# Job lock timeout in seconds
JOB_LOCK_TIMEOUT="300"

# ─── Analytics ────────────────────────────────────────────────────────────────
# Analytics snapshot cron schedule (cron expression)
ANALYTICS_CRON="0 2 * * *"
# Retention period for analytics data in days
ANALYTICS_RETENTION_DAYS="365"

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Enable request logging
ENABLE_REQUEST_LOGGING="true"
# Sentry DSN for error tracking (optional)
SENTRY_DSN=""

# ─── Deployment ───────────────────────────────────────────────────────────────
# App port (used by Docker)
APP_PORT="3000"
# Database port (used by docker-compose)
DB_PORT="5432"
# Redis port (used by docker-compose)
REDIS_PORT="6379"
# Production URL for deployment health checks
PRODUCTION_URL="https://your-domain.com"

# ─── Spline (3D) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SPLINE_SCENE_URL="https://prod.spline.design/your-scene/scene.splinecode"
